# Enforce LF line endings for all text files (important for cross-platform test data)
* text=auto eol=lf
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.txt text eol=lf
*.lock text eol=lf
*.tf text eol=lf
*.rb text eol=lf
*.gemspec text eol=lf
*.gradle text eol=lf
*.sbt text eol=lf
*.config text eol=lf
*.props text eol=lf
