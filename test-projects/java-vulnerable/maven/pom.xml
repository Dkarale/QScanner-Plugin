<?xml version="1.0" encoding="UTF-8"?>
<!-- TD-07a: Java Maven pom.xml with known vulnerable dependencies -->
<!-- Known CVEs: Log4Shell (CVE-2021-44228), Spring4Shell (CVE-2022-22965), jackson (CVE-2021-46877), commons-collections (CVE-2015-6420) -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.qualys.test</groupId>
    <artifactId>qscanner-test-java</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>QScanner Java Test Project</name>
    <description>Test project with known vulnerable Java dependencies for QScanner SCA testing</description>

    <properties>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- CVE-2021-44228 (Log4Shell) — CRITICAL -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>2.14.1</version>
        </dependency>

        <!-- CVE-2021-46877 — HIGH -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.12.3</version>
        </dependency>

        <!-- CVE-2022-22965 (Spring4Shell) — CRITICAL -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
            <version>5.3.10</version>
        </dependency>

        <!-- CVE-2015-6420 — CRITICAL -->
        <dependency>
            <groupId>commons-collections</groupId>
            <artifactId>commons-collections</artifactId>
            <version>3.2.1</version>
        </dependency>
    </dependencies>
</project>
