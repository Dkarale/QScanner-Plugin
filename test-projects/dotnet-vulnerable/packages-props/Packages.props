<Project>
  <!-- TD-09d: .NET Central Package Management (Packages.props) with known vulnerable dependencies -->
  <!-- Known CVEs: Newtonsoft.Json 12.0.3 (CVE-2024-21907), log4net 2.0.8 (CVE-2018-1285) -->
  <ItemGroup>
    <PackageVersion Include="Newtonsoft.Json" Version="12.0.3" />
    <PackageVersion Include="System.Text.RegularExpressions" Version="4.3.0" />
    <PackageVersion Include="log4net" Version="2.0.8" />
  </ItemGroup>
</Project>
