<?xml version="1.0" encoding="utf-8"?>
<!-- TD-09b: .NET packages.config (legacy NuGet) with known vulnerable dependencies -->
<!-- Known CVEs: Newtonsoft.Json 12.0.3 (CVE-2024-21907), System.Text.RegularExpressions 4.3.0 (CVE-2019-0820), log4net 2.0.8 (CVE-2018-1285) -->
<packages>
  <package id="Newtonsoft.Json" version="12.0.3" targetFramework="net48" />
  <package id="System.Text.RegularExpressions" version="4.3.0" targetFramework="net48" />
  <package id="log4net" version="2.0.8" targetFramework="net48" />
</packages>
